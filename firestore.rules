rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: get user role from their profile
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Helper: check if user is admin
    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Courses collection
    match /courses/{courseId} {
      allow read: if true; // Public read for course listings
      allow create, update, delete: if isAdmin();
    }

    // Enrollments collection
    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Mock Tests collection
    match /mockTests/{testId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Test Attempts collection
    match /testAttempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Blog Posts collection
    match /blogPosts/{postId} {
      allow read: if true; // Public read
      allow create, update, delete: if isAdmin();
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true; // Public read
      allow create, update, delete: if isAdmin();
    }

    // Contact messages collection
    match /contactMessages/{messageId} {
      allow create: if true; // Anyone can submit
      allow read, update, delete: if isAdmin();
    }

    // Newsletter subscriptions
    match /newsletter/{subId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
